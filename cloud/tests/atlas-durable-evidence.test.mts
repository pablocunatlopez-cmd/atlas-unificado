import test from 'node:test';import assert from 'node:assert/strict';import {DatabaseSync} from 'node:sqlite';import {createEvidenceRepository} from '../lib/evidence-repository.ts';
function database(){const raw=new DatabaseSync(':memory:');const prepare=(sql:string,values:any[]=[])=>({bind:(...args:any[])=>prepare(sql,args),run:async()=>({success:true,meta:{changes:raw.prepare(sql).run(...values).changes}}),all:async()=>({results:raw.prepare(sql).all(...values)})});return{raw,db:{prepare} as unknown as D1Database};}
const record=(artifactId='test-artifact',date='2026-11-15T15:00:00Z')=>({contractVersion:1,taskId:'test-task',processId:'creative',artifactId,sourceRevision:'abc1234',completedAt:date,verdict:'passed',testIds:['mesh-boundaries'],criteria:['Preserves the source scene.']});
test('evidence survives repository recreation and retries do not duplicate or erase cited integration',async()=>{const {raw,db}=database();try{const a=createEvidenceRepository(db);await a.remember(record());await a.remember({...record(),integratedRevision:'main@abc1234'});const b=createEvidenceRepository(db);await b.remember(record());const rows=await b.list();assert.equal(rows.length,1);assert.equal(rows[0].integratedRevision,'main@abc1234');await b.remember({...record('test-artifact','2026-11-14T15:00:00Z'),verdict:'failed'});assert.equal((await b.list())[0].verdict,'passed');}finally{raw.close();}});
test('invalid reports never persist, dates normalize and list is bounded to most recent reports',async()=>{const {raw,db}=database();try{const repo=createEvidenceRepository(db);await assert.rejects(repo.remember({...record(),testIds:[]}),/INVALID/);assert.equal((await repo.list()).length,0);await repo.remember(record('offset','2026-11-15T18:00:00+02:00'));assert.equal((await repo.list())[0].completedAt,'2026-11-15T16:00:00.000Z');for(let i=0;i<40;i++)await repo.remember(record('artifact-'+i,new Date(Date.UTC(2026,10,16,0,i)).toISOString()));assert.equal((await repo.list()).length,32);assert.equal((await repo.list())[0].artifactId,'artifact-39');}finally{raw.close();}});
