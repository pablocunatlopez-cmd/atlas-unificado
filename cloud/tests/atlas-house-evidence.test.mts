import test from 'node:test';
import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import {createHash} from 'node:crypto';
import {validateHouseWorkEvidence,ABSENT_BASELINE_REVISION} from '../lib/collaboration/house-evidence.ts';
const now=Date.parse('2026-11-14T20:00:00Z'),base={taskId:'work-1',processId:'experience',artifactId:'house-artifact-1',candidateRevision:'a'.repeat(64),completedAt:'2026-11-14T20:00:00Z',checks:[{name:'Contrato reproducible',passed:true}]};
test('the four upstream files remain byte-identical to their recorded provenance',()=>{const p=JSON.parse(readFileSync(new URL('../continuous/github-evidence-provenance.json',import.meta.url),'utf8'));assert.equal(p.commit,'069e38b9ad890f3ef58ee4f0689917372a1367e1');for(const [name,hash]of Object.entries(p.files))assert.equal(createHash('sha256').update(readFileSync(new URL('../continuous/'+name,import.meta.url))).digest('hex'),hash);});
test('a first draft with passing checks is recordable but never a reported improvement or integration',()=>{const r=validateHouseWorkEvidence(base,{now});assert.equal(r.review.status,'consistent_report');assert.equal(r.claim,'reported');assert.equal(r.canRecordArtifact,true);assert.equal(r.reportedImprovement,false);assert.equal(r.report.decision.outcome,'deferred');assert.equal(r.report.comparison.outcome,'incomparable');assert.equal(r.report.comparison.baselineRevision,ABSENT_BASELINE_REVISION);assert.equal('integration' in r.report,false);});
test('digest change alone and identical reruns cannot manufacture improvement',()=>{const changed=validateHouseWorkEvidence({...base,baselineRevision:'b'.repeat(64)},{now});assert.equal(changed.reportedImprovement,false);assert.equal(changed.report.decision.outcome,'deferred');const same=validateHouseWorkEvidence({...base,baselineRevision:base.candidateRevision},{now});assert.equal(same.report.comparison.outcome,'unchanged');assert.equal(same.reportedImprovement,false);});
test('actual numeric comparison plus passing checks remains an explicitly reported result',()=>{const r=validateHouseWorkEvidence({...base,baselineRevision:'b'.repeat(64),measurement:{metric:'Error radial',before:.1,after:.05,direction:'lower'}},{now});assert.equal(r.canRecordArtifact,true);assert.equal(r.reportedImprovement,true);assert.equal(r.report.decision.outcome,'accepted');assert.equal(r.review.status,'consistent_report');assert.equal(r.review.claim,'reported');});
test('missing or failed checks, malformed measurements, bad revisions and future reports fail closed',()=>{for(const value of [{...base,checks:[]},{...base,checks:[{name:'Fallo',passed:false}]},{...base,candidateRevision:'invented'},{...base,completedAt:'2026-11-15T20:00:00Z'},{...base,measurement:{metric:'Error',before:NaN,after:0,direction:'lower'}}]){const r=validateHouseWorkEvidence(value as any,{now});assert.equal(r.canRecordArtifact,false);assert.equal(r.reportedImprovement,false);}const r=validateHouseWorkEvidence({...base,baselineRevision:'b'.repeat(64),checks:[{name:'Regresión',passed:false}],measurement:{metric:'Error',before:.1,after:.05,direction:'lower'}},{now});assert.equal(r.report.decision.outcome,'rejected');assert.equal(r.reportedImprovement,false);});
test('caller inputs are not mutated or accepted as proof of integration',()=>{const value={...base,integration:{revision:'c'.repeat(64),at:base.completedAt},verified:true},before=structuredClone(value);const r=validateHouseWorkEvidence(value,{now});assert.deepEqual(value,before);assert.equal('integration' in r.report,false);assert.equal('verified' in r.report,false);});

test('a repeated artifact revision cannot gain a promotion from changed metric numbers alone',()=>{const r=validateHouseWorkEvidence({...base,baselineRevision:base.candidateRevision,measurement:{metric:'Error',before:1,after:0,direction:'lower'}},{now});assert.equal(r.report.comparison.outcome,'unchanged');assert.equal(r.report.decision.outcome,'deferred');assert.equal(r.reportedImprovement,false);});

test('imported evidence modules match the exact Git blobs in the reviewed GitHub commit',()=>{const p=JSON.parse(readFileSync(new URL('../continuous/github-evidence-provenance.json',import.meta.url),'utf8'));for(const [name,sha]of Object.entries(p.gitBlobSHAs)){const bytes=readFileSync(new URL('../continuous/'+name,import.meta.url));assert.equal(createHash('sha1').update(Buffer.from('blob '+bytes.length+'\0')).update(bytes).digest('hex'),sha);}});
