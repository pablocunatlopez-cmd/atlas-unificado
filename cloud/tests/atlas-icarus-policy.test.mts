import test from 'node:test';import assert from 'node:assert/strict';import {DatabaseSync} from 'node:sqlite';
import {consultInput,consultationProposal,consultationReview,applicationReceipt,ICARUS_PROJECTS,ICARUS_ACQUIRE} from '../lib/collaboration/policy.ts';
import {initialWorld,rememberWorldConsultation} from '../lib/evolution/world.ts';
test('each resident including critics can consult; malformed and unknown actors are rejected',()=>{assert.equal(consultInput({requestId:'x',actorId:'resident:music-console'}).actorId,'resident:music-console');assert.equal(consultInput({requestId:'x',actorId:'cinema-audience-6'}).actorId,'resident:cinema-audience-6');assert.equal(consultInput({requestId:'x',actorId:'games-desk',targetProject:'atlas'}).targetProject,'atlas');for(const raw of [{requestId:' '},{requestId:'x',actorId:'unknown'},{requestId:'x',actorId:['music-console']},{requestId:'x',trigger:'paid'},{requestId:'x',targetProject:'outside'}])assert.throws(()=>consultInput(raw));});
test('proposals cite only sources actually read and publication receipts require exact target and passing checks',()=>{const p={change:'Transponer melodías',reason:'Conservar intervalos musicales',validation:['Conservar intervalos'],sourceIds:['read']};assert.deepEqual(consultationProposal(p,['read']),p);assert.throws(()=>consultationProposal({...p,sourceIds:['invented']},['read']));const r={project_id:ICARUS_PROJECTS.atlas,commit_sha:'a'.repeat(40),version_id:'real-version',summary:'Transposición validada y publicada',checks:[{name:'intervalos',passed:true}]};assert.equal(applicationReceipt(r,'atlas').verification,'reported-by-cloud-workflow');for(const bad of [{...r,project_id:ICARUS_PROJECTS.eras},{...r,commit_sha:'short'},{...r,checks:[{name:'fake',passed:false}]}])assert.throws(()=>applicationReceipt(bad,'atlas'));});
test('the consultation lease rejects a stale duplicate without consuming another consultation',()=>{const db=new DatabaseSync(':memory:');db.exec('CREATE TABLE icarus_control(id TEXT PRIMARY KEY,content TEXT,lease_id TEXT,lease_until INTEGER,revision INTEGER);CREATE TABLE icarus_consultations(request_id TEXT PRIMARY KEY);');db.prepare("INSERT INTO icarus_control VALUES('main','{}',NULL,0,2)").run();db.prepare('INSERT INTO icarus_consultations VALUES(?)').run('same');assert.equal(db.prepare(ICARUS_ACQUIRE).get('{}','lease',1000,2,1,'same'),undefined);assert.ok(db.prepare(ICARUS_ACQUIRE).get('{}','lease',1000,2,1,'different'));db.close();});
test('vocational memory stores a real consultation without turning documents into accepted facts',()=>{const w=initialWorld(),before=structuredClone(w.memories['resident:music-console']),c={id:'icarus-1',actorId:'resident:music-console',domain:'composition',question:'¿Cómo conservar intervalos?',status:'evidence-collected',at:'2026-11-11T20:00:00Z',sources:[{id:'read'}],agents:[]} as any;const next=rememberWorldConsultation(w,c,'run');assert.equal(next.memories[c.actorId].consultation?.sourceIds.length,1);assert.equal(next.memories[c.actorId].reflections,before.reflections);assert.equal(next.memories[c.actorId].conclusion,before.conclusion);assert.deepEqual(rememberWorldConsultation(next,c,'other'),next);});

test('review decisions stay strict while display prose is bounded without discarding a complete review',()=>{assert.equal(consultationReview({decision:'accept',reason:'válida '.repeat(100)}).reason.length,500);assert.throws(()=>consultationReview({decision:'approved',reason:'Texto'}));assert.throws(()=>consultationReview({decision:['accept'],reason:'Texto'}));assert.throws(()=>consultationReview({decision:'accept',reason:''}));});

test('a targeted mission can use newly discovered public documentation without accepting arbitrary network locations',()=>{const v=consultInput({requestId:'mission',actorId:'music-console',problem:'Conservar intervalos al transponer la melodía',sourceUrls:['https://developer.mozilla.org/en-US/docs/Web/API/OscillatorNode/frequency']});assert.equal(v.sourceUrls?.length,1);assert.match(v.problem!,/intervalos/);for(const sourceUrls of [['http://developer.mozilla.org/test'],['https://localhost/test'],['https://example.invalid/test'],[],['https://developer.mozilla.org/a','https://developer.mozilla.org/b','https://developer.mozilla.org/c']])assert.throws(()=>consultInput({requestId:'mission',sourceUrls}));});
