import test from 'node:test';import assert from 'node:assert/strict';import {missionContext} from '../lib/collaboration/baselines.ts';
test('author and reviewer share repository inventory, selected target and documentary evidence',()=>{const mission={title:'Ingeniería 3D',question:'Integrar animaciones existentes',application:'Ampliar la casa',targetProject:'atlas' as const,targetFiles:['public/house/process-creatures.js'],validation:['Comprobar el rig']},docs=[{id:'read',title:'AnimationMixer',text:'API de animación'}],common=missionContext(mission,docs,[{status:'rejected'}]),review={...common,proposal:{change:'Cargar un avatar'}};assert.deepEqual(review.vocation,common.vocation);assert.deepEqual(review.documents,docs);assert.ok(review.relatedBaseline.available.some(s=>s.includes('Avatares')));assert.equal(review.baseline.project,'Atlas');assert.equal(review.vocation.targetProject,'atlas');assert.notEqual(review.vocation.targetFiles,mission.targetFiles);});
