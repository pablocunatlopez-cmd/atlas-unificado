import test from 'node:test';import assert from 'node:assert/strict';import {readFileSync} from 'node:fs';import {createHash} from 'node:crypto';import {missionContext} from '../lib/collaboration/baselines.ts';import {missionMessages} from '../lib/collaboration/context.ts';
const m={title:'Procedencia',question:'Comprobar filtro',application:'Conservar contexto',targetProject:'atlas' as const,targetFiles:['lib/research/grounding.ts'],validation:['Verificar predicado']};
test('shared evidence matches actual source and is separate from public citations',()=>{const shared=missionContext(m,[{id:'public-api',title:'Referencia',text:'Documento público'}]);const evidence=shared.repositoryEvidence;assert.equal(evidence.entries.length,1);const entry=evidence.entries[0],text=readFileSync(new URL('../'+entry.path,import.meta.url),'utf8');assert.equal(entry.sha256,createHash('sha256').update(text).digest('hex'));assert.equal(entry.excerpt,text.slice(0,2000));assert.match(evidence.baseRevision,/^[a-f0-9]{40}$/);for(const messages of [missionMessages('Autor',shared),missionMessages('Revisor',shared,{change:'Aplicar filtro',sourceIds:['public-api']})]){const data=JSON.parse(messages[1].content);assert.deepEqual(data.repositoryEvidence,evidence);assert.equal(data.documents[0].id,'public-api');assert.ok(messages.reduce((n,m)=>n+m.content.length,0)<=16000);}});
test('unrelated missions and ERAS never receive Atlas code evidence',()=>{for(const mission of [{...m,targetFiles:['app/music-studio.tsx']},{...m,targetProject:'eras' as const}])assert.equal(missionContext(mission,[]).repositoryEvidence.entries.length,0);});

test('stale snapshots fail the build guard before publication',async()=>{const {mkdtempSync,mkdirSync,writeFileSync,rmSync}=await import('node:fs');const {tmpdir}=await import('node:os');const {join}=await import('node:path');const {spawnSync}=await import('node:child_process');const dir=mkdtempSync(join(tmpdir(),'atlas-evidence-'));try{for(const folder of ['scripts','lib/research','lib/collaboration','lib/cloud'])mkdirSync(join(dir,folder),{recursive:true});for(const name of ['scripts/collaboration-evidence.mjs','lib/collaboration/repository-evidence.ts','lib/research/grounding.ts','lib/cloud/program-tools.mjs','lib/cloud/queue.mjs'])writeFileSync(join(dir,name),readFileSync(new URL('../'+name,import.meta.url)));writeFileSync(join(dir,'lib/research/grounding.ts'),'// changed source');const result=spawnSync(process.execPath,[join(dir,'scripts/collaboration-evidence.mjs'),'--check'],{encoding:'utf8'});assert.notEqual(result.status,0);assert.match(result.stderr,/evidence is stale/);writeFileSync(join(dir,'lib/research/grounding.ts'),readFileSync(new URL('../lib/research/grounding.ts',import.meta.url)));writeFileSync(join(dir,'lib/cloud/queue.mjs'),'// missing inspected window');const absent=spawnSync(process.execPath,[join(dir,'scripts/collaboration-evidence.mjs'),'--check'],{encoding:'utf8'});assert.notEqual(absent.status,0);assert.match(absent.stderr,/Inspected source window changed/);}finally{rmSync(dir,{recursive:true,force:true});}});

test('program-tool missions receive the inspected numeric implementation and its full-file hash',()=>{const shared=missionContext({...m,targetFiles:['lib/cloud/program-tools.mjs']},[]);assert.equal(shared.repositoryEvidence.entries.length,1);const e=shared.repositoryEvidence.entries[0];assert.equal(e.path,'lib/cloud/program-tools.mjs');assert.match(e.excerpt,/function statistics/);assert.equal(e.sha256,createHash('sha256').update(readFileSync(new URL('../'+e.path,import.meta.url))).digest('hex'));});

test('Pico receives the exact bounded enqueue window in both stages with a full-file hash',()=>{
 const shared=missionContext({...m,targetFiles:['lib/cloud/queue.mjs']},[]),entries=shared.repositoryEvidence.entries;
 assert.equal(entries.length,1);const e=entries[0],source=readFileSync(new URL('../'+e.path,import.meta.url),'utf8');
 assert.equal(e.path,'lib/cloud/queue.mjs');assert.equal(e.sha256,createHash('sha256').update(source).digest('hex'));
 assert.ok(e.excerptStart>0);assert.ok(e.excerptEnd-e.excerptStart<=4000);assert.equal(e.excerpt,source.slice(e.excerptStart,e.excerptEnd));
 assert.match(e.excerpt,/if\(previous\)/);assert.match(e.excerpt,/const saved=await one/);assert.match(e.excerpt,/if\(saved.question/);assert.equal(e.truncated,true);
 for(const messages of [missionMessages('Autor',shared),missionMessages('Revisor',shared,{change:'Comparar los mismos campos antes y después',sourceIds:['public-api']})])assert.deepEqual(JSON.parse(messages[1].content).repositoryEvidence.entries,entries);
});

test('the real Pico mission fits the shared budget without trimming its enqueue evidence',async()=>{
 const {missionFor}=await import('../lib/collaboration/missions.ts');const v=missionFor('resident:body-arm')!;
 const shared=missionContext({title:v.title,question:'Resolver icarus-92 conservando el rechazo. Comparar internet/kind/parameters antes y después de insertar, según el código adjunto. Sin bloqueos de fila inventados.',application:v.application,targetProject:v.targetProject,targetFiles:v.targetFiles,validation:v.validation,owner:{id:v.id,name:v.name,kind:v.kind,delegateResidentId:v.residentId,runtime:v.runtime,origin:v.origin}},[{id:'d1',title:'D1 batch',text:'API pública '.repeat(250)},{id:'http',title:'Idempotencia',text:'Semántica de reintentos '.repeat(150)}],[{id:'icarus-92',status:'rejected',error:'Faltó código de queue.mjs',proposal:'Propuesta anterior '.repeat(40)}]);
 const proposal={change:'Comparar internet, kind y parameters en ambas lecturas; conservar el batch existente.',reason:'Resolver reutilización de un ID con otra acción.',validation:['Probar reintentos idénticos y distintos con SQLite'],sourceIds:['d1','http']};
 for(const messages of [missionMessages('Reglas del autor '.repeat(50),shared),missionMessages('Reglas del revisor '.repeat(50),shared,proposal)]){
  assert.ok(messages.reduce((n,m)=>n+m.content.length,0)<=16000);const payload=JSON.parse(messages[1].content);assert.deepEqual(payload.repositoryEvidence.entries,shared.repositoryEvidence.entries);assert.equal(payload.priorWork[0].error,'Faltó código de queue.mjs');
 }
});
